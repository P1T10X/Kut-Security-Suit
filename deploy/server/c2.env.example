# KUT C2 (Command & Control) sunucu yapılandırması — ÖRNEK.
# Kurulum betiği bu değerleri üretir; elle düzenlerken buradan yararlanın.

# --- Kalıcılık ---
# PostgreSQL bağlantısı. BOŞ bırakılırsa BELLEK-İÇİ DEMO modu çalışır (kalıcılık
# yok — yalnız değerlendirme/test için).
KUT_DATABASE_URL=
# Yalnız KUT_MIGRATE_ON_START=1 için: şema sahibi rolün bağlantısı (DDL gerektiği için
# uygulama rolü migrasyon çalıştıramaz). Yalnız migrasyon sırasında açılır; boşsa
# KUT_DATABASE_URL kullanılır. KUT_MIGRATE_DATABASE_URL_FILE=/path de desteklenir.
KUT_MIGRATE_DATABASE_URL=

# Bellek-içi DEMO modu (kalıcılık YOK) yalnız bununla açılır — üretimde
# KUT_DATABASE_URL doldurun ve bunu ayarlamayın.
KUT_DEMO=1

# --- Kiracı (multi-tenant) ---
# Bu dağıtımın VARSAYILAN kiracı kimliği (küçük harf/rakam/tire, 1-63). Belirtilmezse
# "default". Cihaz kiracısı önce enrollment token'dan bağlanır (POST /api/enrollment-tokens
# ile tenant seçilebilir); cihazın kiracısı yoksa bu varsayılana düşülür (tek-kiracılı uyum).
KUT_TENANT_ID=
# Çok-müşteri SaaS için SIKI kiracı zorlaması: =1 ise kiracıya bağlı OLMAYAN bir cihazın
# olayları REDDEDİLİR (varsayılana sessizce atıflanmaz → cross-tenant karışma önlenir).
# Boş/0 = kapalı (kiracısız cihaz KUT_TENANT_ID'ye düşer). Çok-müşteri kurulumlarda 1 önerilir.
KUT_TENANT_ENFORCE=

# --- Ana anahtar (ZORUNLU) ---
# 32 bayt, base64. Alan şifreleme + HMAC blind index alt anahtarları bundan
# türetilir. GÜVENLE saklayın; kaybı verinin okunamaması demektir.
#
# DOSYA-TABANLI SIR (önerilen, üretim): düz-metin env yerine değeri bir dosyadan
# okutmak için KUT_MASTER_KEY yerine KUT_MASTER_KEY_FILE=/path kullanın. Aynı
# kalıp KUT_DATABASE_URL_FILE ve KUT_MASTER_KEY_OLD_FILE için de geçerli. Böylece
# sır /proc/<pid>/environ veya `ps` üzerinden sızmaz. systemd LoadCredential,
# Docker/K8s secrets ve Vault agent dosya-tabanlı sır sağlar. Env öncelikli;
# yoksa _FILE okunur (içerik kırpılır).
KUT_MASTER_KEY=
KUT_MASTER_KEY_FILE=
# Anahtar ROTASYONU (opsiyonel): virgülle ayrılmış ESKİ base64 ana anahtarlar. Yeni
# veri KUT_MASTER_KEY ile şifrelenir; eski at-rest veri bu anahtarlarla ÇÖZÜLMEYE
# devam eder (veri kaybı YOK). Rotasyon: yeni anahtarı KUT_MASTER_KEY yap, eskisini
# buraya taşı; tüm eski veri yeniden yazıldıktan sonra buradan kaldır.
KUT_MASTER_KEY_OLD=

# --- TLS materyali (ZORUNLU) ---
KUT_CA_CERT=/etc/kut/pki/ca.crt
KUT_CA_KEY=/etc/kut/pki/ca.key
KUT_SERVER_CERT=/etc/kut/pki/server.crt
KUT_SERVER_KEY=/etc/kut/pki/server.key

# --- Dinleme adresleri ---
KUT_LISTEN_AGENT=:8443
KUT_LISTEN_ENROLL=:8444
KUT_LISTEN_ADMIN=:8445

# --- Demo modu yönetici tohumu (yalnız KUT_DATABASE_URL boşken geçerli) ---
# Üretimde (DB modu) yönetici için: tools/adminseed ile INSERT SQL üretin.
KUT_DEMO_ADMIN_EMAIL=admin@local
KUT_DEMO_ADMIN_PASSWORD=

# --- Saklama (KVKK) ---
KUT_RETENTION_DAYS=90

# --- Giriş kaba-kuvvet koruması ---
# İstemci başına bu kadar başarısız denemeden sonra KUT_LOGIN_LOCKOUT süresi kilit.
KUT_LOGIN_MAX_ATTEMPTS=5
KUT_LOGIN_LOCKOUT=15m

# --- Gözlemlenebilirlik (Prometheus /metrics) ---
# Ayarlanırsa GET /metrics bu statik Bearer token ile açılır (scraper: Authorization:
# Bearer <token>). BOŞ bırakılırsa uç tamamen KAPALIDIR (toplu veriyi kimliksiz
# sızdırmama — güvenli varsayılan). Rastgele üretin: openssl rand -hex 24
KUT_METRICS_TOKEN=
# İkiliye gömülü sürüm etiketi (kut_build_info metriği için); boşsa "dev".
KUT_BUILD_VERSION=
# Hazır alarm kuralları: deploy/prometheus-alerts.example.yml (cert ömrü, boru-hattı
# durması, kaba-kuvvet, yanal hareket, saldırı zinciri, IoC).

# --- Dış uyarı (SOC webhook) ---
# Ayarlanırsa yüksek önem düzeyli güvenlik olayları bir HTTPS webhook'una POST
# edilir (Slack/Teams/genel). URL https OLMALI. Boşsa uyarı gönderilmez.
KUT_ALERT_WEBHOOK_URL=
# Uyarı eşiği: bu ve üstü önem düzeyleri gönderilir (INFO/LOW/MEDIUM/HIGH/CRITICAL).
KUT_ALERT_MIN_SEVERITY=HIGH
# Uyarı gövde biçimi: "json" (varsayılan, ham Alert) veya "slack" (Slack/Teams
# incoming webhook — {"text":...} okunabilir mesaj).
KUT_ALERT_FORMAT=
# İmzalama (opsiyonel): ayarlanırsa giden webhook gövdesi HMAC-SHA256 ile imzalanır
# ve X-KUT-Signature: sha256=<hex> başlığında gönderilir. Alıcı paylaşılan sırla
# doğrulayıp uyarının GERÇEKTEN KUT'ten geldiğini teyit eder (sahte uyarı önleme).
KUT_ALERT_WEBHOOK_SECRET=
# Yönlendirme (routing): ayarlanırsa webhook'a YALNIZ eşleşen uyarılar gider.
# Virgülle ayrılmış kategori allowlist'i (ör. SECURITY,POLICY_VIOLATION). Boş → hepsi.
KUT_ALERT_CATEGORIES=
# Virgülle ayrılmış ATT&CK tekniği allowlist'i (ör. T1055,T1003). Boş → hepsi.
KUT_ALERT_TECHNIQUES=
# Yükseltme (escalation): aynı cihaz|kategori için ESCALATE_WINDOW içinde bu kadar
# yüksek-önem uyarı birikince BİR kez CRITICAL "ESCALATED" uyarısı üretilir (on-call
# sayfası). 0/boş = kapalı.
KUT_ALERT_ESCALATE_COUNT=
# Yükseltme penceresi (varsayılan 10m). Ör: 5m, 1h.
KUT_ALERT_ESCALATE_WINDOW=
# Yükseltmeye sayılan asgari önem (varsayılan HIGH).
KUT_ALERT_ESCALATE_MIN_SEVERITY=HIGH

# --- Çok-sinyal korelasyon (gelişmiş korelasyon) ---
# Aynı cihazda KUT_CHAIN_WINDOW (varsayılan 15m) içinde KUT_CHAIN_THRESHOLD
# (varsayılan 3) FARKLI kill-chain sinyali (teknik/taktik) birikirse, tek tespitten
# daha güçlü kanıt olan YÜKSEK-GÜVENLİ bir saldırı-zinciri uyarısı üretilir.
# Eşik 0 → kapalı.
KUT_CHAIN_WINDOW=
KUT_CHAIN_THRESHOLD=

# --- Harici log alımı (SIEM ingest, #21) ---
# Ayarlanırsa POST /api/ingest açılır: harici kaynaklar (güvenlik duvarı, bulut,
# kimlik sağlayıcı, başka SIEM) JSON, CEF veya LEEF loglarını bu statik Bearer token ile
# gönderir; loglar KUT olay modeline normalize edilip korelasyon/tespit/hunt
# yüzeyine yazılır. Her kaynak adından türetilen kararlı bir cihaz kimliğine eşlenir.
# Boşsa uç KAPALIDIR. Güçlü, rastgele bir token kullanın.
#   JSON: Content-Type: application/json, gövde [{"source","category","severity","message",...}]
#   Winlog: Content-Type: application/json + ?format=winlog (ya da gövdede "winlog"/"event_id"
#           imi): Windows olay günlüğü (winlogbeat/nxlog/EVTX); EventID+kanala göre sınıflanır.
#   CEF : satır başına "CEF:0|Vendor|Product|...".
#   Syslog: satır başına "<PRI>..." (RFC5424/3164; rsyslog omhttp/fluent-bit HTTP).
#   LEEF: satır başına "LEEF:2.0|Vendor|Product|...|attrs" (QRadar; tab-ayraçlı öznitelik).
KUT_INGEST_TOKEN=
# Hız sınırı: harici log alımı için IP-başına saniyede istek (DoS/sel koruması).
# Varsayılan 50; tavan 2x. 0 → sınırsız.
KUT_INGEST_RATE_PER_SEC=

# --- Sertifika ömür-sonu izleme ---
# Sunucu/CA sertifikaları uzun-ömürlü ve OTO-YENİLENMEZ (ajan sertifikaları kısa-ömürlü
# + oto-yenilenir). Sessiz süre dolması KESİNTİdir. Kalan gün bu eşiğin altına inince
# başlangıçta + günlük UYARI loglanır (JSON log → SIEM). Varsayılan 30 gün.
KUT_CERT_EXPIRY_WARN_DAYS=

# --- Zamanlanmış / sürekli tehdit-avı ---
# Ayarlanırsa (ör. 15m) kayıtlı aramalar (SIEM saved searches) periyodik olarak SON
# ARALIK penceresinde çalıştırılır; yeni eşleşme bulan aramalar loglanır (JSON log →
# SIEM sürekli-tespit). Konsoldan kayıtlı arama oluşturun. 0/boş = kapalı.
KUT_HUNT_INTERVAL=

# --- Zamanlanmış duruş raporu teslimi ---
# KUT_REPORT_INTERVAL (varsayılan 24s) her dolduğunda duruş özeti loglanır. Ek olarak
# KUT_REPORT_WEBHOOK_URL ayarlanırsa tam rapor JSON'u bu HTTPS uca POST edilir
# (SOC/SIEM/otomasyon). URL https OLMALI. KUT_REPORT_WEBHOOK_SECRET verilirse gövde
# HMAC-SHA256 ile imzalanıp X-KUT-Signature başlığında gönderilir (kaynak doğrulama).
KUT_REPORT_INTERVAL=
KUT_REPORT_WEBHOOK_URL=
KUT_REPORT_WEBHOOK_SECRET=

# --- Bakım / bastırma pencereleri (#18) ---
# Ayarlanırsa planlı bakım aralıklarında (opsiyonel cihaz/kategori kapsamı) uyarılar
# bastırılır — beklenen etkinlik SOC'u gereksiz uyandırmaz. JSON dizisi; biçim için
# deploy/server/suppress.example.json. allow_above ile kritikler yine geçebilir.
# Konsol görünürlüğü: GET /api/maintenance. Boşsa bastırma kapalı.
KUT_SUPPRESS_FILE=
# Canlı hot-reload: ayarlanırsa (ör. 5m) pencere dosyası periyodik yeniden okunur ve
# SUNUCU YENİDEN BAŞLATILMADAN güncellenir. Okuma hatasında eski küme korunur. Boş/0 = kapalı.
KUT_SUPPRESS_RELOAD_INTERVAL=

# --- İmzalı denetim dışa aktarımı (harici değişmez arşiv, #16) ---
# GET /api/audit/export, denetim izini kurcalama-kanıtlı hash-zincirli JSONL olarak
# verir (denetçi/WORM arşiv C2'DEN BAĞIMSIZ doğrular: server/cmd/auditverify).
# Bu Ed25519 özel anahtar (base64) ayarlıysa dışa aktarıma imzalı manifest eklenir
# (köken kanıtı). Boşsa dışa aktarım imzasızdır (yalnız hash zinciri bütünlüğü).
# Üretme: go run ./tools/otasign -genkey -out ./audit-keys (özel anahtarı base64'le).
KUT_AUDIT_EXPORT_KEY=

# --- Otomatik müdahale (SOAR) ---
# =1 ise KRİTİK güvenlik olayında (kurcalama, sahte güncelleme/script reddi) cihaz
# otomatik KARANTİNAYA alınır (insan beklemeden). Varsayılan KAPALI — karantina
# bozucu bir eylemdir; bilinçli açın.
KUT_AUTO_RESPONSE=

# --- Tehdit istihbaratı (IoC) ---
# Ayarlanırsa bilinen-kötü göstergeler (IP/MAC/alan adı/hash/süreç) yüklenir ve
# eşleşen olaylar KRİTİK uyarı üretir. Biçim için deploy/server/ioc.example.txt.
# İmzalı IoC (opsiyonel, kurcalamaya karşı): KUT_IOC_PUBKEY (base64 Ed25519) ayarlıysa
# feed YALNIZ <dosya>.sig imzası doğrulanınca yüklenir (kurcalanmış feed tespiti körleştiremez).
KUT_IOC_PUBKEY=
KUT_IOC_FILE=
# Canlı hot-reload: ayarlanırsa (ör. 5m) IoC dosyası periyodik yeniden okunur ve
# göstergeler SUNUCU YENİDEN BAŞLATILMADAN güncellenir (yeni tehdit istihbaratı
# anında yürürlüğe girer). Okuma hatasında eski küme korunur. Boş/0 = kapalı.
KUT_IOC_RELOAD_INTERVAL=

# --- Özel tespit kuralları (operatör-tanımlı) ---
# Ayarlanırsa yerleşik tespit kurallarına EKLENİR (koda dokunmadan kuruma özgü
# tespit içeriği). JSON dizisi; biçim için deploy/server/detect-rules.example.json.
# İmzalı kurallar (opsiyonel, kurcalamaya karşı): KUT_DETECT_RULES_PUBKEY (base64 Ed25519)
# ayarlıysa kural dosyası YALNIZ <dosya>.sig imzası doğrulanınca yüklenir (fail-closed).
# İmzalama: go run ./server/cmd/detectsign -key detect_ed25519.key -rules detect-rules.json
KUT_DETECT_RULES_PUBKEY=
KUT_DETECT_RULES_FILE=
# Canlı hot-reload: ayarlanırsa (ör. 5m) ve KUT_DETECT_RULES_FILE varsa, kural
# dosyası periyodik yeniden okunur ve motor SUNUCU YENİDEN BAŞLATILMADAN güncellenir
# (hem ingest değerlendirmesi hem konsol kataloğu). Okuma hatasında eski korunur.
# Boş/0 = kapalı.
KUT_DETECT_RELOAD_INTERVAL=

# --- SIEM iletici (syslog + CEF/LEEF) ---
# Ayarlanırsa olaylar bir SIEM'e (ArcSight/QRadar/Splunk) syslog üzerinden iletilir.
# Adres host:port. Boşsa iletilmez.
KUT_SIEM_ADDR=
# Taşıma: "udp" (varsayılan) veya "tcp".
KUT_SIEM_PROTO=udp
# Biçim: "cef" (varsayılan, ArcSight) veya "leef" (QRadar).
KUT_SIEM_FORMAT=cef
# İletim eşiği: bu ve üstü önem düzeyleri (INFO/LOW/MEDIUM/HIGH/CRITICAL).
KUT_SIEM_MIN_SEVERITY=HIGH

# --- Zafiyet eşleştirme (envanterden) ---
# Ayarlanırsa yazılım envanteri bilinen zafiyet veri kümesiyle eşleştirilir ve
# zafiyetli cihazlar konsolda işaretlenir. Biçim için deploy/vuln-sample.json.
KUT_VULN_FILE=

# --- Çift-kontrol (dört-göz) WIPE ---
# Çift-kontrol VARSAYILAN OLARAK AÇIKTIR: uzaktan WIPE bir ADMIN'in TALEBİ + FARKLI
# bir ADMIN'in ONAYINI gerektirir; onaya kadar komut kuyruğa GİRMEZ (tek ele geçirilmiş/
# kötü-niyetli ADMIN filoyu silemez). Bunu DEVRE DIŞI bırakıp tek-ADMIN doğrudan WIPE'a
# (GÜVENSİZ) izin vermek için aşağıyı =1 yapın. Üretimde boş bırakın (çift-kontrol açık kalsın).
KUT_WIPE_SINGLE_ADMIN_UNSAFE=

# --- Yatay ölçekleme (çok-düğüm HA) ---
# =1 ise canlı konsol akışı (SSE) düğümler arası Postgres LISTEN/NOTIFY ile
# fan-out edilir; yük dengeleyici arkasındaki TÜM C2 düğümleri aynı PostgreSQL'i
# paylaşmalı (KUT_DATABASE_URL zorunlu). Boş/0 → tek düğüm (bellek-içi bus).
# Bildirim kanalını değiştirmek için KUT_CLUSTER_CHANNEL (varsayılan kut_notice).
KUT_CLUSTER=
KUT_CLUSTER_CHANNEL=

# --- Loglama biçimi ---
# "json" → tüm sunucu logları yapısal JSON satırları (SIEM/log toplama, ör. Loki/ELK).
# Boş/diğer → "[c2] " prefix'li standart metin (varsayılan).
KUT_LOG_FORMAT=

# --- C2 beacon tespiti (ağ periyodikliği) ---
# Varsayılan AÇIK. netconn geçmişini periyodik analiz eder; düzenli-aralıklı
# (düşük-jitter) uzak IP'leri olası C2 beacon (SECURITY olayı) olarak işaretler —
# bilinen IoC olmadan bilinmeyen C2'yi yakalar. Kapatmak için değere ayarlayın.
KUT_BEACON_DISABLE=
# Analiz sıklığı (vars. 10m) ve geriye-bakış penceresi (vars. 2h).
KUT_BEACON_INTERVAL=
KUT_BEACON_WINDOW=

# --- DNS tünelleme tespiti ---
# Bir cihaz kısa pencerede tek üst alanın çok sayıda farklı alt alanını sorgularsa
# olası DNS-tüneli (veri kaçırma). KUT_DNSTUNNEL_DISABLE=1 kapatır; eşik
# KUT_DNSTUNNEL_MIN (varsayılan 20), pencere KUT_DNSTUNNEL_WINDOW (5m).
KUT_DNSTUNNEL_DISABLE=
KUT_DNSTUNNEL_MIN=

# --- Kaba-kuvvet / parola-püskürtme tespiti (T1110) ---
# Windows olay günlüğü alımından gelen başarısız oturum açma olayları (4625/4771) tek
# bir kaynak ana bilgisayarda kısa pencerede yoğunlaşırsa tek bir yüksek-önemli kampanya
# bulgusuna toplanır. KUT_BRUTEFORCE_DISABLE=1 kapatır; eşik KUT_BRUTEFORCE_MIN
# (varsayılan 10), pencere KUT_BRUTEFORCE_WINDOW (5m), tarama KUT_BRUTEFORCE_INTERVAL (10m).
# Ayrıca: başarısız-seriden SONRA gelen başarılı oturum açma olası HESAP ELE GEÇİRME'dir
# (CRITICAL); başarı-öncesi başarısız eşiği KUT_BRUTEFORCE_SUCCESS_MIN (varsayılan 8).
KUT_BRUTEFORCE_DISABLE=
KUT_BRUTEFORCE_MIN=
KUT_BRUTEFORCE_SUCCESS_MIN=

# --- Merkezi Scope / ROE guardrail (§4) ---
# Yüksek-etkili operasyonlar (WIPE/QUARANTINE/LOCK/RESTART) hedefe uygulanmadan ÖNCE
# scope+ROE kapısından geçer. Hiçbir KUT_SCOPE_* ayarlı DEĞİLSE motor bağlanmaz
# (eski davranış birebir korunur). KUT_SCOPE_ENFORCE=1 ZORLAMA (kapsam-dışı op reddedilir);
# ayarlı değilken kararlar yalnız DENETLENİR (kut_scope_would_deny_total + audit), engellenmez.
# İzin/hariç seçiciler virgülle ayrılır. Yıkıcı aksiyonlar (WIPE/exploitation) açıkça
# KUT_SCOPE_ALLOW_DESTRUCTIVE=1 ile etkinleştirilmelidir (aksi halde fail-closed).
KUT_SCOPE_ENFORCE=
KUT_SCOPE_ALLOW_DEVICES=
KUT_SCOPE_ALLOW_TENANTS=
KUT_SCOPE_ALLOW_ENVIRONMENTS=
KUT_SCOPE_ALLOW_NETWORKS=
KUT_SCOPE_ALLOW_DOMAINS=
KUT_SCOPE_EXCLUDE_DEVICES=
KUT_SCOPE_EXCLUDE_HOSTS=
KUT_SCOPE_ALLOW_DESTRUCTIVE=

# --- Olay yineleme-tespiti (§6, /api/ingest) ---
# Aynı olay (içerik-adresli EventID) pencere içinde tekrar gelirse düşürülür
# (retransmit/çift-gönderim → çift-saymayı önler). KUT_INGEST_TOKEN ayarlıyken devrede.
# Pencere 0 → kapalı. KUT_INGEST_DEDUP_MAX izlenen azami id (varsayılan 100000).
KUT_INGEST_DEDUP_WINDOW=
KUT_INGEST_DEDUP_MAX=
